APP_URL=https://seu-projeto.vercel.app
# Na Vercel: Settings → Environment Variables → DATABASE_URL (Production, Preview e Development)
# Prefira o Transaction pooler do Supabase (porta 6543) em serverless
# Projeto: https://supabase.com/dashboard/project/xcudogkslwoqvwsmxoit
DATABASE_URL=postgresql://postgres.xcudogkslwoqvwsmxoit:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
MASTER_EMAIL=nathan.k@example.net
MASTER_USERNAME=admin
MASTER_PASSWORD=troque-esta-senha-forte
# OAuth Web (Google Cloud). Sem Client ID e Secret a integração Drive fica indisponível.
# Ative Google Drive API e Google Sheets API. Redirect: {APP_URL}/app/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Na Vercel: CRON_SECRET. O job diário /cron/google-backup envia Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Token do Mapbox (pk.*) — obrigatório para o mapa da Abrangência.
# Na Vercel: Settings → Environment Variables → MAPBOX_ACCESS_TOKEN
MAPBOX_ACCESS_TOKEN=
# GEOCODER_PROVIDER=mapbox
# Instância UAZAPI (WhatsApp). Prefira Configurações → Integrações no painel.
UAZAPI_URL=
UAZAPI_TOKEN=
# GitHub: https://github.com/felipegoulart06-lab/firestepCRM
