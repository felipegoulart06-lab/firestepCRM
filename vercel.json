{
  "regions": ["gru1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "memory": 1024,
      "maxDuration": 60,
      "excludeFiles": "{storage/**,*.sqlite,php.ini,.env,.git/**,supabase/**,**/*.md}"
    }
  },
  "crons": [
    {
      "path": "/cron/google-backup",
      "schedule": "0 6 * * *"
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/favicon.ico", "dest": "/public/assets/favicon.png" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
